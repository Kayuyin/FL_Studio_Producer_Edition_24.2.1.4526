rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validNameAndCommune(data) {
        return data.nombre is string
          && data.nombre.size() >= 2
          && data.nombre.size() <= 70
          && data.comuna is string
          && data.comuna.size() <= 80;
      }

      allow get: if isOwner();
      allow list: if false;

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'comuna', 'creadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'correo', 'comuna', 'creadoEn'])
        && validNameAndCommune(request.resource.data)
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.creadoEn == request.time;

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'comuna'])
        && validNameAndCommune(request.resource.data);
      allow delete: if false;
    }

    // Publicaciones visibles para usuarios con sesión activa.
    match /publicaciones/{postId} {
      function loggedIn() {
        return request.auth != null;
      }

      function validPublication(data) {
        return data.keys().hasOnly([
            'categoria', 'autorUid', 'autorNombre', 'equipoNombre',
            'titulo', 'descripcion', 'comuna', 'futbol', 'nivel',
            'fecha', 'hora', 'estado', 'creadoEn'
          ])
          && data.keys().hasAll([
            'categoria', 'autorUid', 'autorNombre', 'equipoNombre',
            'titulo', 'descripcion', 'comuna', 'futbol', 'nivel',
            'fecha', 'hora', 'estado', 'creadoEn'
          ])
          && data.categoria in [
            'persona_busca_equipo', 'equipo_busca_jugadores', 'equipo_busca_rival', 'busca_cancha'
          ]
          && data.autorUid is string
          && data.autorUid == request.auth.uid
          && data.autorNombre is string
          && data.autorNombre.size() >= 2
          && data.autorNombre.size() <= 70
          && data.equipoNombre is string
          && data.equipoNombre.size() <= 80
          && (
            (data.categoria in ['persona_busca_equipo', 'busca_cancha'] && data.equipoNombre == '')
            || (data.categoria in ['equipo_busca_jugadores', 'equipo_busca_rival'] && data.equipoNombre.size() >= 2)
          )
          && data.titulo is string
          && data.titulo.size() >= 5
          && data.titulo.size() <= 110
          && data.descripcion is string
          && data.descripcion.size() >= 15
          && data.descripcion.size() <= 1200
          && data.comuna is string
          && data.comuna.size() >= 2
          && data.comuna.size() <= 80
          && (data.categoria != 'busca_cancha' || data.comuna in [
            'Alhué', 'Buin', 'Calera de Tango', 'Cerrillos', 'Cerro Navia', 'Colina', 'Conchalí', 'Curacaví', 'El Bosque', 'El Monte', 'Estación Central', 'Huechuraba', 'Independencia', 'Isla de Maipo', 'La Cisterna', 'La Florida', 'La Granja', 'La Pintana', 'La Reina', 'Lampa', 'Las Condes', 'Lo Barnechea', 'Lo Espejo', 'Lo Prado', 'Macul', 'Maipú', 'María Pinto', 'Melipilla', 'Ñuñoa', 'Padre Hurtado', 'Paine', 'Pedro Aguirre Cerda', 'Peñaflor', 'Peñalolén', 'Pirque', 'Providencia', 'Pudahuel', 'Puente Alto', 'Quilicura', 'Quinta Normal', 'Recoleta', 'Renca', 'San Bernardo', 'San Joaquín', 'San José de Maipo', 'San Miguel', 'San Pedro', 'San Ramón', 'Santiago', 'Talagante', 'Tiltil', 'Vitacura'
          ])
          && data.futbol in ['Fútbol 5', 'Fútbol 7', 'Fútbol 8', 'Fútbol 11']
          && data.nivel in ['Amateur', 'Intermedio', 'Avanzado']
          && data.fecha is string
          && (data.fecha == '' || data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && data.hora is string
          && (data.hora == '' || data.hora.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && (data.categoria != 'equipo_busca_rival' || (data.fecha != '' && data.hora != ''))
          && data.estado == 'activa'
          && data.creadoEn == request.time;
      }

      allow read: if loggedIn();

      allow create: if loggedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && validPublication(request.resource.data)
        && request.resource.data.autorNombre ==
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombre;

      allow update, delete: if false;
    }

    // Las demás colecciones permanecen bloqueadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
